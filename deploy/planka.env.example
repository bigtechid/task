DATABASE_URL=postgresql://planka:CHANGE_ME@postgres/planka
SECRET_KEY=CHANGE_ME
BASE_URL=https://task.bigtech.id
TRUST_PROXY=true
TERMS_TYPE=custom
DEFAULT_ADMIN_EMAIL=admin@bigtech.id
DEFAULT_ADMIN_PASSWORD=CHANGE_ME
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_USERNAME=admin

# Single sign-on (OIDC, e.g. Google). Leave empty to disable.
# Redirect URI to register at the provider: <BASE_URL>/login
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated; only these e-mail domains may log in (empty = any domain)
OIDC_ALLOWED_DOMAINS=
# OIDC_BUTTON_TEXT=Masuk dengan Google

# Skip the Terms of Service step at login
# DISABLE_TERMS=true
